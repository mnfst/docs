{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Manifest LLM Gateway",
  "theme": "maple",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://manifest.build"
  },
  "favicon": "/favicon.svg",
  "css": "/style.css",
  "js": "/scripts/no-tab-jump.js",
  "banner": {
    "content": "**NEW LAUNCH** The self-healing layer for APIs. [Read more](https://manifest.build/blog/manifest-is-taking-a-new-direction/)",
    "dismissible": false
  },
  "colors": {
    "primary": "#0f172a",
    "light": "#ffffff",
    "dark": "#0f172a"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#fcfaf5",
      "dark": "#171717"
    }
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 700
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "seo": {
    "metatags": {
      "canonical": "https://manifest.build",
      "og:site_name": "Manifest LLM Gateway",
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "twitter:site": "@Manifestforai",
      "twitter:creator": "@Manifestforai"
    },
    "indexing": "all"
  },
  "thumbnails": {
    "background": "#0891b2"
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "add-mcp",
      "cursor",
      "vscode"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "search": {
    "prompt": "Search in docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "Open dashboard",
        "href": "https://app.manifest.build"
      },
      {
        "type": "github",
        "href": "https://github.com/mnfst/llm-gateway"
      },
      {
        "type": "discord",
        "href": "https://discord.gg/FepAked3W7"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Book a call",
      "href": "https://calendly.com/sebastien-manifest/30min"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "LLM Gateway",
        "groups": [
          {
            "group": "Getting Started",
            "boost": 3,
            "pages": [
              "llm-gateway/docs/introduction"
            ]
          },
          {
            "group": "Self-hosting",
            "boost": 2,
            "pages": [
              "llm-gateway/docs/deploy",
              "llm-gateway/docs/self-hosted",
              {
                "group": "Managed platforms",
                "icon": "cloud",
                "expanded": false,
                "pages": [
                  "llm-gateway/docs/deploy/railway",
                  "llm-gateway/docs/deploy/render",
                  "llm-gateway/docs/deploy/digitalocean",
                  "llm-gateway/docs/deploy/fly",
                  "llm-gateway/docs/deploy/heroku",
                  "llm-gateway/docs/deploy/koyeb"
                ]
              },
              {
                "group": "Cloud providers",
                "icon": "server",
                "expanded": false,
                "pages": [
                  "llm-gateway/docs/deploy/aws",
                  "llm-gateway/docs/deploy/gcp"
                ]
              },
              {
                "group": "Server panels",
                "icon": "panel-top",
                "expanded": false,
                "pages": [
                  "llm-gateway/docs/deploy/coolify",
                  "llm-gateway/docs/deploy/easypanel"
                ]
              }
            ]
          },
          {
            "group": "Features",
            "boost": 2,
            "pages": [
              "llm-gateway/docs/llm-gateway",
              "llm-gateway/docs/autofix",
              "llm-gateway/docs/observability",
              "llm-gateway/docs/request-logs"
            ]
          },
          {
            "group": "CLI & MCP",
            "icon": "terminal",
            "boost": 2,
            "pages": [
              "llm-gateway/docs/cli"
            ]
          },
          {
            "group": "Providers",
            "boost": 2,
            "pages": [
              "llm-gateway/docs/providers/api-key-providers",
              "llm-gateway/docs/providers/subscription-based-providers",
              "llm-gateway/docs/providers/custom-providers",
              "llm-gateway/docs/providers/local-models"
            ]
          },
          {
            "group": "Integrations",
            "boost": 2,
            "pages": [
              "llm-gateway/docs/integrations/n8n",
              "llm-gateway/docs/integrations/mcp"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "llm-gateway/docs/reference/api",
              "llm-gateway/docs/reference/headers",
              "llm-gateway/docs/reference/environment-variables",
              "llm-gateway/docs/reference/telemetry",
              "llm-gateway/docs/errors",
              "llm-gateway/docs/reference/glossary"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    },
    {
      "source": "/docs",
      "destination": "/introduction"
    },
    {
      "source": "/install",
      "destination": "/self-hosted"
    },
    {
      "source": "/docker",
      "destination": "/self-hosted"
    },
    {
      "source": "/telemetry",
      "destination": "/reference/telemetry"
    },
    {
      "source": "/privacy",
      "destination": "/reference/telemetry"
    },
    {
      "source": "/cloud-vs-local",
      "destination": "/introduction"
    },
    {
      "source": "/cloud-vs-self-hosted",
      "destination": "/introduction"
    },
    {
      "source": "/get-started",
      "destination": "/introduction"
    },
    {
      "source": "/track-usage",
      "destination": "/observability"
    },
    {
      "source": "/routing",
      "destination": "/llm-gateway"
    },
    {
      "source": "/fallback",
      "destination": "/llm-gateway"
    },
    {
      "source": "/set-limits",
      "destination": "/observability"
    },
    {
      "source": "/errors/M301",
      "destination": "/errors"
    },
    {
      "source": "/configuration",
      "destination": "/self-hosted"
    },
    {
      "source": "/contributing",
      "destination": "https://github.com/mnfst/llm-gateway"
    },
    {
      "source": "/message-recording",
      "destination": "/request-logs"
    }
  ]
}
