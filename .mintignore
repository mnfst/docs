# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Non-docs files: the harness the agents read, never published.
# The scripts the site loads live in js/, which stays published.
AGENTS.md
CLAUDE.md
references/
scripts/

# Draft content
drafts/
*.draft.mdx
